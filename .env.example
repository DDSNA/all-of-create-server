# Copy to .env and edit. Read the Minecraft EULA (https://aka.ms/MinecraftEULA)
# and set EULA=TRUE only if you accept it. The server refuses to start otherwise.
EULA=FALSE

# Java heap (-Xms/-Xmx). Guide: 6G for 1-4 players, 8G for 5-10, 10G for 10-15, 12G+ beyond.
MEMORY=8G
# Container memory cap; keep ~1.5-2G above MEMORY.
MEM_LIMIT=10g

# Host side of the port mapping. Use BIND_ADDRESS=127.0.0.1 for local-only.
BIND_ADDRESS=0.0.0.0
SERVER_PORT=25565

# Optional server.properties overrides (empty = keep whatever is in data/server.properties)
MOTD=All of Create
DIFFICULTY=
MAX_PLAYERS=
VIEW_DISTANCE=
SIMULATION_DISTANCE=
ONLINE_MODE=
LEVEL_SEED=
# true -> sets white-list and enforce-whitelist
ENABLE_WHITELIST=

# Comma-separated player names. When set, ops.json / whitelist.json are rewritten
# from these lists on every start (UUIDs from the Mojang API, or offline UUIDs if online-mode=false).
OPS=
OPS_LEVEL=4
WHITELIST=

# RCON is enabled only when a password is set. Port is not published by compose;
# use `docker exec` or add a port mapping yourself.
RCON_PASSWORD=
RCON_PORT=25575

# Advanced
# Extra JVM args appended after the built-in G1 flags
JVM_OPTS=
ALWAYS_PRE_TOUCH=false
# true -> move data/config to data/backups/ and re-copy the pack's configs on next start
RESEED_CONFIG=false
